# ===== Git 元数据（约 210MB，构建完全不需要）=====
.git
.gitignore

# ===== 开发 / CI 配置（构建不需要）=====
.github
.husky
.vscode
commitlint.config.js
.nano-staged.json

# ===== 依赖与本地缓存（构建时重新安装 / 重新生成）=====
node_modules
src/.vuepress/dist
src/.vuepress/.cache
src/.vuepress/.temp

# ===== 本地工具数据与文档 =====
.workbuddy
README.md
LICENSE

# ===== 杂项 =====
*.log
.DS_Store
